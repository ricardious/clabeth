---
import { Moon, Sun } from '@lucide/astro';
---

<button
  type="button"
  class="theme-toggle inline-flex size-[var(--control-h-md)] items-center justify-center rounded-md text-muted transition-colors duration-[var(--dur-fast)] hover:bg-hover hover:text-foreground"
  aria-label="Cambiar tema"
>
  <span data-theme-icon="light"><Sun size={17} aria-hidden="true" /></span>
  <span data-theme-icon="dark" hidden><Moon size={17} aria-hidden="true" /></span>
</button>

<script>
  import { readStoredTheme, writeStoredTheme } from '../../lib/theme-storage';
  import type { ThemeMode } from '../../lib/types/theme';

  function applyTheme(theme: ThemeMode): void {
    window.document.documentElement.dataset.theme = theme;
    window.document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
      button.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((icon) => {
        icon.hidden = icon.dataset.themeIcon !== theme;
      });
      button.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Tema oscuro (cambiar a claro)' : 'Tema claro (cambiar a oscuro)',
      );
    });
  }

  window.document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    if (button.dataset.ready === 'true') return;
    button.dataset.ready = 'true';
    button.addEventListener('click', () => {
      const next: ThemeMode = readStoredTheme() === 'dark' ? 'light' : 'dark';
      writeStoredTheme(next);
      applyTheme(next);
      // La página de ajustes muestra la misma preferencia en sus tarjetas.
      window.dispatchEvent(new CustomEvent<ThemeMode>('clabeth:theme', { detail: next }));
    });
  });

  applyTheme(readStoredTheme());
  window.addEventListener('clabeth:theme', (event) => {
    applyTheme((event as CustomEvent<ThemeMode>).detail);
  });
</script>
