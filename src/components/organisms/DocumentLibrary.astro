---
import { Copy, FilePlus, Files, Pencil, Search, SearchX, Trash2, X } from '@lucide/astro';
import Select from '../atoms/Select.astro';
import { PAPER_STYLES } from '../../lib/paper/styles';
---

<div id="document-library" class="p-6">
  <div data-library-error class="mb-4 hidden rounded-md border border-error bg-primary-soft/30 px-3 py-2 text-sm text-error" role="alert"></div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <div class="relative">
      <Search size={16} aria-hidden="true" class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-muted" />
      <input
        data-library-search
        type="search"
        role="searchbox"
        aria-label="Buscar documentos"
        placeholder="Buscar por título o contenido…"
        class="h-[var(--control-h-md)] w-full rounded-md border border-outline bg-surface pl-8 pr-8 text-sm text-foreground placeholder:text-muted focus-visible:outline-2 focus-visible:outline-focus-ring focus-visible:outline-offset-1 [&::-webkit-search-cancel-button]:hidden"
      />
      <button data-clear-search type="button" aria-label="Limpiar búsqueda" class="absolute right-1.5 top-1/2 hidden -translate-y-1/2 rounded-sm p-1 text-muted hover:text-foreground">
        <X size={14} aria-hidden="true" />
      </button>
    </div>
    <div class="flex gap-2">
      <Select class="w-44" data-library-sort aria-label="Ordenar documentos">
        <option value="actualizado">Más recientes</option>
        <option value="creado">Más antiguos</option>
        <option value="titulo">Título</option>
      </Select>
      <Select class="w-48" data-library-paper aria-label="Filtrar por tipo de papel">
        <option value="todos">Todos los papeles</option>
        {PAPER_STYLES.map((style) => <option value={style.id}>{style.name}</option>)}
      </Select>
    </div>
    <p data-library-count class="text-xs tabular-nums text-muted" aria-live="polite">0 documentos</p>
  </div>

  <div class="mt-6">
    <section data-empty-library class="hidden rounded-lg border border-dashed border-outline bg-surface px-6 py-14 text-center">
      <Files size={32} aria-hidden="true" class="mx-auto text-muted" />
      <h2 class="mt-3 font-display text-lg font-semibold text-foreground-strong">Todavía no hay documentos</h2>
      <p class="mx-auto mt-1 max-w-md text-sm text-muted">Crea el primero o parte de una plantilla. Clabeth guarda todo en tu navegador.</p>
      <button data-create-document type="button" class="mt-5 inline-flex h-[var(--control-h-md)] items-center gap-1.5 rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary-strong">
        <FilePlus size={16} aria-hidden="true" /> Crear primer documento
      </button>
    </section>

    <section data-empty-results class="hidden rounded-lg border border-dashed border-outline bg-surface px-6 py-14 text-center">
      <SearchX size={32} aria-hidden="true" class="mx-auto text-muted" />
      <h2 class="mt-3 font-display text-lg font-semibold text-foreground-strong">Sin resultados</h2>
      <p data-empty-results-message class="mx-auto mt-1 max-w-md text-sm text-muted"></p>
    </section>

    <div data-document-grid class="grid grid-cols-[repeat(auto-fill,minmax(230px,1fr))] gap-4"></div>
  </div>
</div>

<template id="document-card-template">
  <article class="group flex flex-col overflow-hidden rounded-lg border border-outline bg-surface shadow-panel transition-shadow duration-[var(--dur-med)] hover:shadow-pop">
    <button data-open-preview type="button" class="relative block h-44 overflow-hidden bg-panel text-left">
      <div class="pointer-events-none absolute inset-0 flex items-start justify-center pt-3">
        <div data-thumbnail-paper class="paper-bg h-[150px] w-[190px] overflow-hidden rounded-sm border border-outline">
          <div data-thumbnail class="hand-scope h-full w-full overflow-hidden p-3"></div>
        </div>
      </div>
      <span class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-[var(--panel)] to-transparent" aria-hidden="true"></span>
    </button>
    <div class="flex flex-1 flex-col gap-1.5 p-3">
      <button data-open-title type="button" class="text-left font-display text-[15px] font-semibold leading-snug text-foreground-strong hover:text-primary"></button>
      <p data-document-meta class="text-xs text-muted"></p>
      <div class="flex flex-wrap gap-1">
        <span data-preset-badge class="inline-flex items-center rounded-full bg-primary-soft px-2 py-0.5 text-xs font-medium text-primary"></span>
        <span data-paper-badge class="inline-flex items-center rounded-full bg-panel px-2 py-0.5 text-xs font-medium text-muted"></span>
      </div>
      <div class="mt-auto flex items-center justify-end gap-0.5 pt-1 opacity-0 transition-opacity duration-[var(--dur-fast)] group-focus-within:opacity-100 group-hover:opacity-100">
        <button data-rename type="button" aria-label="Renombrar" title="Renombrar" class="inline-flex size-[var(--control-h-sm)] items-center justify-center rounded-md text-muted hover:bg-hover hover:text-foreground"><Pencil size={14} aria-hidden="true" /></button>
        <button data-duplicate type="button" aria-label="Duplicar" title="Duplicar" class="inline-flex size-[var(--control-h-sm)] items-center justify-center rounded-md text-muted hover:bg-hover hover:text-foreground"><Copy size={14} aria-hidden="true" /></button>
        <button data-delete type="button" aria-label="Eliminar" title="Eliminar" class="inline-flex size-[var(--control-h-sm)] items-center justify-center rounded-md text-error hover:bg-primary-soft"><Trash2 size={14} aria-hidden="true" /></button>
      </div>
    </div>
  </article>
</template>

<dialog id="rename-document-dialog" aria-labelledby="rename-document-title" class="m-auto w-[min(420px,92vw)] rounded-lg border border-outline bg-surface p-0 text-foreground shadow-pop">
  <form method="dialog" class="p-5">
    <h2 id="rename-document-title" class="font-display text-lg font-semibold text-foreground-strong">Renombrar documento</h2>
    <input data-rename-input aria-label="Nuevo título" class="mt-3 h-[var(--control-h-md)] w-full rounded-md border border-outline bg-surface px-2.5 text-sm text-foreground" />
    <div class="mt-4 flex justify-end gap-2">
      <button value="cancel" class="h-[var(--control-h-md)] rounded-md px-3 text-sm text-muted hover:bg-hover">Cancelar</button>
      <button data-confirm-rename value="default" class="h-[var(--control-h-md)] rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary-strong">Renombrar</button>
    </div>
  </form>
</dialog>

<dialog id="delete-document-dialog" aria-labelledby="delete-document-title" class="m-auto w-[min(420px,92vw)] rounded-lg border border-outline bg-surface p-0 text-foreground shadow-pop">
  <form method="dialog" class="p-5">
    <h2 id="delete-document-title" class="font-display text-lg font-semibold text-foreground-strong">Eliminar documento</h2>
    <p data-delete-message class="mt-2 text-sm text-muted"></p>
    <div class="mt-5 flex justify-end gap-2">
      <button value="cancel" class="h-[var(--control-h-md)] rounded-md px-3 text-sm text-muted hover:bg-hover">Cancelar</button>
      <button data-confirm-delete value="default" class="h-[var(--control-h-md)] rounded-md bg-error px-3 text-sm font-medium text-primary-foreground">Eliminar</button>
    </div>
  </form>
</dialog>

<script>
  import type { ClabethDocument } from '../../lib/types/document';
  import { createDocument } from '../../lib/defaults';
  import { duplicateDocument, queryDocuments, renameDocument, type DocumentSortKey } from '../../lib/documents/library';
  import { getPreset } from '../../lib/handwriting/presets';
  import { handCssVars } from '../../lib/handwriting/css-vars';
  import { splitIntoBlocks } from '../../lib/markdown/blocks';
  import { estimatePages, textStats } from '../../lib/markdown/stats';
  import { contentHeight, contentWidth, getPaperStyle } from '../../lib/paper/styles';
  import { loadLibrary, saveLibrary } from '../../lib/storage/repository';
  import { formatRelativeTime } from '../../lib/utils/format';

  const root = window.document.querySelector<HTMLElement>('#document-library');
  const cardTemplate = window.document.querySelector<HTMLTemplateElement>('#document-card-template');
  const grid = root?.querySelector<HTMLElement>('[data-document-grid]');
  const search = root?.querySelector<HTMLInputElement>('[data-library-search]');
  const clearSearch = root?.querySelector<HTMLButtonElement>('[data-clear-search]');
  const sort = root?.querySelector<HTMLSelectElement>('[data-library-sort]');
  const paper = root?.querySelector<HTMLSelectElement>('[data-library-paper]');
  const count = root?.querySelector<HTMLElement>('[data-library-count]');
  const emptyLibrary = root?.querySelector<HTMLElement>('[data-empty-library]');
  const emptyResults = root?.querySelector<HTMLElement>('[data-empty-results]');
  const emptyResultsMessage = root?.querySelector<HTMLElement>('[data-empty-results-message]');
  const errorNotice = root?.querySelector<HTMLElement>('[data-library-error]');
  const renameDialog = window.document.querySelector<HTMLDialogElement>('#rename-document-dialog');
  const renameInput = renameDialog?.querySelector<HTMLInputElement>('[data-rename-input]');
  const deleteDialog = window.document.querySelector<HTMLDialogElement>('#delete-document-dialog');
  const deleteMessage = deleteDialog?.querySelector<HTMLElement>('[data-delete-message]');

  let documents: ClabethDocument[] = [];
  let renameTarget: string | null = null;
  let deleteTarget: string | null = null;
  let renderRevision = 0;
  const thumbnailCache = new Map<string, { updatedAt: number; html: string }>();

  function navigateToEditor(id: string): void {
    window.location.assign(`/app/editor?id=${id}`);
  }

  function readNewDocumentDefaults(): { presetId?: string; paperStyle?: string } {
    try {
      const settings = JSON.parse(localStorage.getItem('clabeth.settings.v1') ?? '{}') as {
        state?: { defaultPresetId?: string; defaultPaperStyle?: string };
      };
      return { presetId: settings.state?.defaultPresetId, paperStyle: settings.state?.defaultPaperStyle };
    } catch {
      return {};
    }
  }

  function saveDocuments(): void {
    const result = saveLibrary(documents);
    if (!result.ok && errorNotice) {
      errorNotice.textContent = `${result.error} Tus cambios recientes podrían no guardarse.`;
      errorNotice.classList.remove('hidden');
    }
  }

  function presetName(document: ClabethDocument): string {
    const ids = ['clara', 'escolar', 'tecnica', 'cursiva', 'apuntes', 'elegante'];
    const id = ids.find((candidate) => {
      const config = getPreset(candidate).config;
      return config.fontId === document.handwriting.fontId && config.inkId === document.handwriting.inkId;
    });
    return getPreset(id ?? 'clara').name;
  }

  async function thumbnailHtml(document: ClabethDocument): Promise<string> {
    const cached = thumbnailCache.get(document.id);
    if (cached?.updatedAt === document.updatedAt) return cached.html;
    const markdown = splitIntoBlocks(document.content)
      .filter((block) => !block.pageBreak)
      .slice(0, 6)
      .map((block) => block.markdown)
      .join('\n\n');
    const { renderMarkdown } = await import('../../lib/markdown/render');
    const hand = { ...document.handwriting, fontSize: 12, lineHeight: 1.65, jitterY: 0.4, jitterRot: 0.2 };
    const html = markdown.trim() === '' ? '' : await renderMarkdown(markdown, document.id, hand);
    thumbnailCache.set(document.id, { updatedAt: document.updatedAt, html });
    return html;
  }

  async function createCard(document: ClabethDocument): Promise<HTMLElement | null> {
    const card = cardTemplate?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
    if (!card) return null;
    const openPreview = card.querySelector<HTMLButtonElement>('[data-open-preview]');
    const openTitle = card.querySelector<HTMLButtonElement>('[data-open-title]');
    const thumbnailPaper = card.querySelector<HTMLElement>('[data-thumbnail-paper]');
    const thumbnail = card.querySelector<HTMLElement>('[data-thumbnail]');
    const stats = textStats(document.content);
    const pages = estimatePages(stats.words, document.handwriting.fontSize, document.handwriting.lineHeight, contentWidth(document.paper), contentHeight(document.paper));
    const paperDefinition = getPaperStyle(document.paper.style);

    if (openPreview) openPreview.setAttribute('aria-label', `Abrir «${document.title}»`);
    if (openTitle) openTitle.textContent = document.title;
    card.querySelector<HTMLElement>('[data-document-meta]')!.textContent = `${formatRelativeTime(document.updatedAt)} · ${stats.words} palabras · ${pages} pág.`;
    card.querySelector<HTMLElement>('[data-preset-badge]')!.textContent = presetName(document);
    card.querySelector<HTMLElement>('[data-paper-badge]')!.textContent = paperDefinition.name;

    if (thumbnail && thumbnailPaper) {
      thumbnailPaper.classList.add(`paper-${paperDefinition.id}`);
      const hand = { ...document.handwriting, fontSize: 12, lineHeight: 1.65, jitterY: 0.4, jitterRot: 0.2 };
      // La hoja lleva las variables; la escritura vive dentro para que su
      // `mix-blend-mode: multiply` se mezcle con el papel y no con la tarjeta.
      Object.entries(handCssVars(hand, 8)).forEach(([name, value]) => thumbnailPaper.style.setProperty(name, value));
      thumbnail.innerHTML = await thumbnailHtml(document);
    }

    openPreview?.addEventListener('click', () => navigateToEditor(document.id));
    openTitle?.addEventListener('click', () => navigateToEditor(document.id));
    card.querySelector<HTMLButtonElement>('[data-rename]')?.addEventListener('click', () => {
      renameTarget = document.id;
      if (renameInput) renameInput.value = document.title;
      renameDialog?.showModal();
      renameInput?.focus();
    });
    card.querySelector<HTMLButtonElement>('[data-duplicate]')?.addEventListener('click', () => {
      const copy = duplicateDocument(document);
      documents = [copy, ...documents];
      saveDocuments();
      navigateToEditor(copy.id);
    });
    card.querySelector<HTMLButtonElement>('[data-delete]')?.addEventListener('click', () => {
      deleteTarget = document.id;
      if (deleteMessage) deleteMessage.textContent = `¿Eliminar «${document.title}»? Esta acción no se puede deshacer.`;
      deleteDialog?.showModal();
    });
    return card;
  }

  async function renderLibrary(): Promise<void> {
    if (!grid || !search || !sort || !paper || !count || !emptyLibrary || !emptyResults) return;
    const revision = ++renderRevision;
    const filtered = queryDocuments(documents, {
      search: search.value,
      sort: sort.value as DocumentSortKey,
      paperStyle: paper.value,
    });
    count.textContent = `${filtered.length} ${filtered.length === 1 ? 'documento' : 'documentos'}`;
    clearSearch?.classList.toggle('hidden', search.value === '');
    emptyLibrary.classList.toggle('hidden', documents.length !== 0);
    emptyResults.classList.toggle('hidden', documents.length === 0 || filtered.length !== 0);
    grid.classList.toggle('hidden', filtered.length === 0);
    if (emptyResultsMessage) emptyResultsMessage.textContent = `Nada coincide con «${search.value}» en este papel. Prueba a limpiar el filtro.`;

    const cards = await Promise.all(filtered.map(createCard));
    if (revision !== renderRevision) return;
    grid.replaceChildren(...cards.filter((card): card is HTMLElement => card !== null));
  }

  const loaded = loadLibrary();
  documents = loaded.documents;
  if (!loaded.ok && errorNotice) {
    errorNotice.textContent = `${loaded.error} Tus cambios recientes podrían no guardarse.`;
    errorNotice.classList.remove('hidden');
  }
  void renderLibrary();

  search?.addEventListener('input', () => void renderLibrary());
  sort?.addEventListener('change', () => void renderLibrary());
  paper?.addEventListener('change', () => void renderLibrary());
  clearSearch?.addEventListener('click', () => {
    if (!search) return;
    search.value = '';
    search.focus();
    void renderLibrary();
  });
  root?.querySelector<HTMLButtonElement>('[data-create-document]')?.addEventListener('click', () => {
    const document = createDocument({ title: 'Sin título', ...readNewDocumentDefaults() });
    documents = [document, ...documents];
    saveDocuments();
    navigateToEditor(document.id);
  });
  renameDialog?.querySelector<HTMLButtonElement>('[data-confirm-rename]')?.addEventListener('click', (event) => {
    event.preventDefault();
    if (!renameTarget || !renameInput) return;
    documents = documents.map((document) => document.id === renameTarget ? renameDocument(document, renameInput.value) : document);
    saveDocuments();
    renameTarget = null;
    renameDialog.close();
    void renderLibrary();
  });
  deleteDialog?.querySelector<HTMLButtonElement>('[data-confirm-delete]')?.addEventListener('click', (event) => {
    event.preventDefault();
    if (!deleteTarget) return;
    documents = documents.filter((document) => document.id !== deleteTarget);
    thumbnailCache.delete(deleteTarget);
    saveDocuments();
    deleteTarget = null;
    deleteDialog.close();
    void renderLibrary();
  });
</script>
