---
import { Plus } from '@lucide/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="flex h-[var(--topbar-h)] shrink-0 items-center gap-3 border-b border-outline bg-surface pl-14 pr-4 md:px-4">
  <h1 class="font-display text-[17px] font-semibold text-foreground-strong">{title}</h1>
  <div class="ml-auto">
    <button
      id="new-document"
      type="button"
      class="inline-flex h-[var(--control-h-sm)] items-center justify-center gap-1.5 rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-strong"
    >
      <Plus size={15} aria-hidden="true" /> Nuevo documento
    </button>
  </div>
</header>

<script>
  import type { PageSizeId, PaperStyleId } from '../../lib/types/paper';
  import { createDocument } from '../../lib/defaults';
  import { loadLibrary, saveLibrary } from '../../lib/storage/repository';

  window.document.querySelector<HTMLButtonElement>('#new-document')?.addEventListener('click', () => {
    let presetId: string | undefined;
    let paperStyle: PaperStyleId | undefined;
    let pageSize: PageSizeId | undefined;
    try {
      const settings = JSON.parse(localStorage.getItem('clabeth.settings.v1') ?? '{}') as {
        state?: { defaultPresetId?: string; defaultPaperStyle?: PaperStyleId; defaultPageSize?: PageSizeId };
      };
      presetId = settings.state?.defaultPresetId;
      paperStyle = settings.state?.defaultPaperStyle;
      pageSize = settings.state?.defaultPageSize;
    } catch {
      // Los valores por defecto cubren preferencias dañadas.
    }

    const result = loadLibrary();
    const document = createDocument({ title: 'Sin título', presetId, paperStyle });
    if (pageSize) document.paper.size = pageSize;
    saveLibrary([document, ...result.documents]);
    window.location.assign(`/app/editor?id=${document.id}`);
  });
</script>
