---
import '../styles/fonts-ui.css';
import '../styles/index.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = 'Clabeth — escritura manuscrita desde Markdown',
  description = 'Clabeth convierte Markdown y fórmulas LaTeX en documentos con apariencia de escritura manuscrita.',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c81e2e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        const key = 'clabeth.settings.v1';
        const value = JSON.parse(localStorage.getItem(key) || '{}');
        let theme = value?.state?.theme;
        if ((value?.version ?? 0) === 0 && theme === 'system') {
          theme = 'light';
          value.state.theme = 'light';
          value.version = 1;
          localStorage.setItem(key, JSON.stringify(value));
        }
        if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
        else if (theme !== 'system') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
